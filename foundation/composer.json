{
    "name": "widstudios/foundation",
    "description": "Il codice che ogni progetto della WidStudios AI Factory eredita: tenancy, action, DTO, repository, moduli.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/config": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/filesystem": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WidStudios\\Foundation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WidStudios\\Foundation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WidStudios\\Foundation\\FoundationServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "analyse": "phpstan analyse",
        "test": "pest",
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
