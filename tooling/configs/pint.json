{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "strict_param": true,
        "void_return": true,
        "fully_qualified_strict_types": true,
        "global_namespace_import": {
            "import_classes": true,
            "import_constants": false,
            "import_functions": false
        },
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "not_operator_with_successor_space": true,
        "single_quote": true,
        "concat_space": {
            "spacing": "none"
        },
        "trailing_comma_in_multiline": {
            "elements": ["arrays", "arguments", "parameters", "match"]
        },
        "phpdoc_align": {
            "align": "left"
        },
        "no_superfluous_phpdoc_tags": {
            "allow_mixed": false,
            "remove_inheritdoc": true
        },
        "ordered_class_elements": {
            "order": [
                "use_trait",
                "case",
                "constant_public",
                "constant_protected",
                "constant_private",
                "property_public",
                "property_protected",
                "property_private",
                "construct",
                "destruct",
                "magic",
                "method_public",
                "method_protected",
                "method_private"
            ]
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "legacy"
    ],
    "notName": [
        "*.blade.php",
        "_ide_helper*.php"
    ]
}
