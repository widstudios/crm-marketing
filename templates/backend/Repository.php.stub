 * orderBy(), withRelations() -- non sta astraendo niente, e la logica di
 * lettura torna a sparpagliarsi nei chiamanti.
 *
 * @extends BaseEloquentRepository<{{ Entity }}>
 */
final class {{ Class }} extends BaseEloquentRepository
{
    protected function model(): string
    {
        return {{ Entity }}::class;
    }

