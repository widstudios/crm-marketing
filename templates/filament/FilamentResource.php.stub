<?php

declare(strict_types=1);

namespace {{ Namespace }};

use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables\Table;

/**
 * Risorsa Filament per {{ Entity }}.
 *
 * Un Resource e' un punto di ingresso, come un controller: dichiara la forma
 * dell'interfaccia e delega. Non contiene logica di business, non esegue
 * mutazioni dirette, non decide regole.
 *
 * Il punto in cui questo si perde e' sempre lo stesso: un'azione
 * personalizzata con tre righe di logica dentro. Quelle tre righe non saranno
 * mai applicate dall'API, dall'importazione o dal comando.
 */
final class {{ Class }} extends Resource
{
    protected static ?string $model = {{ Entity }}::class;

    protected static ?string $navigationIcon = 'heroicon-o-rectangle-stack';

    // Etichette in italiano: sono cio' che l'utente legge.
    protected static ?string $modelLabel = '{{-- singolare, es. Lotto --}}';

    protected static ?string $pluralModelLabel = '{{-- plurale, es. Lotti --}}';

    protected static ?string $navigationGroup = '{{-- gruppo di menu --}}';

    protected static ?int $navigationSort = 10;

    /**
     * La voce di menu compare solo a chi ha il permesso.
     *
     * Non e' sicurezza -- quella e' nella Policy -- ma interfaccia: mostrare
     * una voce che porta a un errore di autorizzazione e' un difetto di
     * usabilita'.
     */
    public static function shouldRegisterNavigation(): bool
    {
        return auth()->user()?->can('{{ permission }}.view') ?? false;
    }

    public static function form(Form $form): Form
    {
        return $form->schema([
            // Le regole di validazione stanno anche qui, oltre che nella Form
            // Request dell'API: sono due punti di ingresso, e ognuno valida il
            // proprio input.
            //
            // TextInput::make('number')
            //     ->label('Numero')
            //     ->required()
            //     ->maxLength(50),
            //
            // Select::make('status')
            //     ->label('Stato')
            //     ->options({{ Entity }}Status::class)
            //     ->required(),
        ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            // Le relazioni usate nelle colonne si caricano in anticipo:
            // senza, ogni riga dell'elenco esegue una query in piu' e il
            // problema si vede solo con dati reali.
            ->modifyQueryUsing(fn (Builder $query): Builder => $query->with(['article']))
            ->columns([
                // TextColumn::make('number')->label('Numero')->searchable()->sortable(),
                // TextColumn::make('status')->label('Stato')->badge(),
            ])
            ->filters([
                // I filtri corrispondono a colonne indicizzate: un filtro su
                // una colonna senza indice e' una scansione completa a ogni
                // caricamento della pagina.
            ])
            ->actions([
                // Ogni azione personalizzata autorizza esplicitamente e delega
                // a un'Action: e' il punto in cui l'autorizzazione NON e'
                // automatica, e dove i difetti si nascondono.
                //
                // Action::make('approve')
                //     ->label('Approva')
                //     ->authorize(fn ({{ Entity }} $record): bool => auth()->user()->can('approve', $record))
                //     ->requiresConfirmation()
                //     ->action(fn ({{ Entity }} $record) => app(Approve{{ Entity }}Action::class)
                //         ->execute(new Approve{{ Entity }}Data($record->getKey()))),
            ])
            ->bulkActions([
                // Le azioni massive lavorano a blocchi e delegano alla coda
                // oltre una soglia: un'azione su 5.000 righe eseguita in
                // sincrono va in timeout, e l'utente non sa quante ne siano
                // state elaborate.
            ]);
    }

    /**
     * @return array<string, mixed>
     */
    public static function getPages(): array
    {
        return [
            // 'index' => Pages\List{{ Entity }}::route('/'),
            // 'create' => Pages\Create{{ Entity }}::route('/create'),
            // 'edit' => Pages\Edit{{ Entity }}::route('/{record}/edit'),
        ];
    }
}

{{--
NESSUNO SCOPE DI TENANT

Con un database per tenant, l'elenco mostra gia' i soli dati del cliente
corrente: non esiste nulla da filtrare. Un modifyQueryUsing() che aggiunge
where('tenant_id', …) e' il segnale che chi lo ha scritto sta ragionando sul
modello sbagliato.

CIO' CHE NON VA IN UN RESOURCE (rules/filament.md)
  - logica di business                  → Action
  - mutazioni dirette sul model         → Action
  - query complesse                     → Query object
  - autorizzazione implicita            → Policy + ->authorize() sulle azioni
--}}
