# ---------------------------------------------------------------------------
# {{ Project }} — variabili d'ambiente
#
# Questo file e' VERSIONATO e non contiene segreti, nemmeno di esempio
# realistico: un valore che sembra vero viene copiato in produzione da qualcuno
# che ha fretta. I segnaposto sono deliberatamente evidenti
# (rules/security.md R30).
#
# Nessuna chiamata a env() fuori da config/: con la cache di configurazione
# attiva restituisce null, e il difetto si manifesta solo in produzione.
# ---------------------------------------------------------------------------

APP_NAME="{{ Project }}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://admin.localhost
APP_LOCALE=it
APP_FALLBACK_LOCALE=it

# In produzione, senza eccezioni:
#   APP_ENV=production
#   APP_DEBUG=false          con true la pagina d'errore espone configurazione,
#                            percorsi e talvolta credenziali

# --- Multitenancy ----------------------------------------------------------

# Domini della piattaforma: non appartengono a nessun tenant.
FOUNDATION_CENTRAL_DOMAIN=admin.localhost

FOUNDATION_LANDLORD_CONNECTION=landlord
FOUNDATION_TENANT_CONNECTION=tenant
FOUNDATION_TENANT_TEMPLATE=mysql
FOUNDATION_TENANT_DB_PREFIX=tenant_

# Primo segmento di ogni chiave di cache. Cambiarlo invalida tutta la cache:
# e' anche il modo piu' rapido di svuotarla dopo un rilascio problematico.
FOUNDATION_CACHE_PREFIX=ws

FOUNDATION_TENANT_DISK=tenant

# --- Database --------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_LANDLORD_DATABASE=landlord
DB_USERNAME=SOSTITUIRE_UTENTE
DB_PASSWORD=SOSTITUIRE_PASSWORD

# L'utenza che serve le richieste NON ha bisogno di CREATE DATABASE. Il
# provisioning di un tenant usa un'utenza dedicata, con quel privilegio e
# nient'altro.
DB_PROVISIONING_USERNAME=SOSTITUIRE_UTENTE_PROVISIONING
DB_PROVISIONING_PASSWORD=SOSTITUIRE_PASSWORD_PROVISIONING

# --- Cache, code, sessione -------------------------------------------------

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false      # true in ogni ambiente servito su HTTPS
SESSION_SAME_SITE=lax

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Posta -----------------------------------------------------------------

# Negli ambienti non di produzione la posta non esce mai verso indirizzi reali.
MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@esempio-non-valido.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage ---------------------------------------------------------------

FILESYSTEM_DISK=local
FOUNDATION_TENANT_STORAGE_ROOT=/var/www/html/storage/tenants

# --- Osservabilita' --------------------------------------------------------

LOG_CHANNEL=stack
LOG_LEVEL=debug            # warning o error in produzione

# Disabilitato in produzione: espone richieste, query e talvolta dati.
TELESCOPE_ENABLED=false

{{--
IN PRODUZIONE

  APP_DEBUG=false · APP_ENV=production · LOG_LEVEL=warning
  SESSION_SECURE_COOKIE=true · TELESCOPE_ENABLED=false

I segreti non stanno in un file .env copiato a mano: stanno nel gestore di
segreti dell'ambiente. Questo file dice QUALI variabili servono, non quanto
valgono.
--}}
